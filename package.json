{
  "name": "serpapi-local-agent-lab",
  "version": "0.1.0",
  "description": "Test local LLM agents against SerpApi's real-time search APIs. TanStack Start + React 19 + shadcn/ui.",
  "author": "Tomás Murúa",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serpapi/local-llm-web-search.git"
  },
  "scripts": {
    "dev": "vite dev --port 3005",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^1.47.0",
    "nitro": "3.0.260903-beta",
    "openai": "^7.21.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-external-links": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "serpapi": "^2.2.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.5"
